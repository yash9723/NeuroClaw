# NeuroClaw Full Backend Configuration
# Copy to .env and adjust variables as needed

# Host IP for mobile phone to connect over LAN
VITE_API_HOST=192.168.55.40

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Android Debug Bridge (ADB) Path
ADB_PATH=C:\Users\yashr\AppData\Local\Android\Sdk\platform-tools\adb.exe

# OpenClaw Gemini Flash LAM Planning Key (Optional - falls back offline if not provided)
# GEMINI_API_KEY=your_gemini_api_key_here

# Hardware NPU Profile (true = 45 TOPS INT4 Monster Mode)
MONSTER_MODE=true
